end2"},{"t0":161.296,"t1":163.37,"text":"每一块都是对齐好的我","key":"end2"},{"t0":165.02,"t1":166.013,"text":"然后砖墙碎掉","key":"end3"},{"t0":166.013,"t1":166.702,"text":"掉一地","key":"end3"},{"t0":167.302,"t1":168.701,"text":"这里我故意停了一下","key":"end4"},{"t0":168.701,"t1":169.661,"text":"什么都不放","key":"end4"},{"t0":172.111,"t1":174.288,"text":"再让碎片像粒子一样飞回来","key":"end5"},{"t0":174.288,"t1":175.97,"text":"聚成隧道，一头冲进去","key":"end5"},{"t0":175.97,"t1":176.959,"text":"标题出来","key":"end5"},{"t0":177.259,"t1":179.521,"text":"第一版是砖墙直接变隧道","key":"end6"},{"t0":179.521,"t1":181.783,"text":"看着没劲。加了这一下停顿","key":"end6"},{"t0":181.783,"t1":183.081,"text":"结尾才立住","key":"end6"},{"t0":184.731,"t1":185.739,"text":"车也翻了不少","key":"fail1"},{"t0":186.039,"t1":187.702,"text":"原来前面有几下白闪","key":"fail2"},{"t0":187.702,"t1":189.528,"text":"回看的时候眼睛真难受","key":"fail2"},{"t0":189.528,"t1":191.321,"text":"我全换成了暖色的光","key":"fail2"},{"t0":191.621,"t1":194.086,"text":"还有一条细竖线从头挂到尾","key":"fail3"},{"t0":194.086,"t1":197.261,"text":"找了好久，原来是划痕素材里自带的","key":"fail3"},{"t0":197.561,"t1":199.811,"text":"还有一版结尾直接白成一片","key":"fail4"},{"t0":199.811,"t1":201.686,"text":"砖上的脸全看不见了","key":"fail4"},{"t0":203.036,"t1":205.106,"text":"回头看，整条路就是这几步","key":"flow1"},{"t0":205.406,"t1":206.79,"text":"AI帮了我很多","key":"flow2"},{"t0":206.79,"t1":208.309,"text":"算得快，改得也快","key":"flow2"},{"t0":208.309,"t1":209.524,"text":"可哪一刀好看","key":"flow2"},{"t0":209.524,"t1":212.561,"text":"哪里该停，都是我自己一遍遍看出来的","key":"flow2"},{"t0":214.211,"t1":215.575,"text":"好，完整版来了","key":"full"},{"t0":250.785,"t1":251.824,"text":"问你个问题","key":"cta1"},{"t0":251.824,"t1":253.199,"text":"结尾那一下停顿","key":"cta1"},{"t0":253.199,"t1":254.406,"text":"你觉得是加分","key":"cta1"},{"t0":254.406,"t1":256.417,"text":"还是多余？评论区告诉我","key":"cta1"},{"t0":256.717,"t1":259.239,"text":"下期我把对齐这一步单独拆开讲","key":"cta2"},{"t0":259.239,"t1":260.899,"text":"想看的话，点个关注","key":"cta2"}],"cues":[{"t":11.338000000000001,"kind":"whoosh"},{"t":28.924,"kind":"whoosh"},{"t":38.149,"kind":"whoosh"},{"t":49.775,"kind"