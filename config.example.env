# copy to .env, fill in, then: set -a; source .env; set +a
MONTAGE_ROOT=$HOME/montage
MONTAGE_SOURCES_CSV=$HOME/montage/sources.csv      # cid,path,dur,date,verdict  (rows with verdict=是我 are scanned)
MONTAGE_PHOTOS=$HOME/montage/photos
MONTAGE_REF_FACE=$HOME/montage/reference_face.jpg
MONTAGE_OUT=$HOME/montage/out
MONTAGE_FINAL=$HOME/montage/out/opening_4k.mp4
MONTAGE_SCORE_JOB=trailer
MONTAGE_PIPELINE=/path/to/face-aligned-montage/pipeline   # only needed when scripts are exec'd inside Resolve
EXPLAINER_ROOT=$HOME/explainer
VOICE_DIR=$HOME/explainer/vo/voices
VOICE=my_voice
EXPLAINER_BED=$HOME/explainer/music/bed.wav
ACESTEP_DIR=$HOME/ACE-Step-1.5
